# PORT
PORT=5000
NODE_ENV=development

# PostgreSQL / Supabase Database
DATABASE_URL=postgresql://postgres:your_supabase_db_password@db.your-project-ref.supabase.co:5432/postgres
PGSSLMODE=require
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

# Optional local PostgreSQL fallback when DATABASE_URL is not set
# Set PGSSLMODE=disable for a local PostgreSQL server without SSL.
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=yourpassword
PGDATABASE=ecw_database
PGPORT=5432

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=Publishable Key
SUPABASE_SERVICE_ROLE_KEY=Secret Key
SUPABASE_BUCKET=product-images
